		<item name="colorOnPrimary">@color/kazuji_onPrimary</item>
		<item name="colorOnPrimaryContainer">@color/kazuji_onPrimaryContainer</item>
		<item name="colorPrimaryInverse">@color/kazuji_inversePrimary</item>
		<item name="colorSecondary">@color/kazuji_secondary</item>
		<item name="colorSecondaryContainer">@color/kazuji_secondaryContainer</item>
		<item name="colorOnSecondary">@color/kazuji_onSecondary</item>
		<item name="colorOnSecondaryContainer">@color/kazuji_onSecondaryContainer</item>
		<item name="colorTertiary">@color/kazuji_tertiary</item>
		<item name="colorTertiaryContainer">@color/kazuji_tertiaryContainer</item>
		<item name="colorOnTertiary">@color/kazuji_onTertiary</item>
		<item name="colorOnTertiaryContainer">@color/kazuji_onTertiaryContainer</item>
		<item name="colorSurface">@color/kazuji_surface</item>
		<item name="colorSurfaceDim">@color/kazuji_surfaceDim</item>
		<item name="colorSurfaceBright">@color/kazuji_surfaceBright</item>
		<item name="colorSurfaceContainerLowest">@color/kazuji_surfaceContainerLowest</item>
		<item name="colorSurfaceContainerLow">@color/kazuji_surfaceContainerLow</item>
		<item name="colorSurfaceContainer">@color/kazuji_surfaceContainer</item>
		<item name="colorSurfaceContainerHigh">@color/kazuji_surfaceContainerHigh</item>
		<item name="colorSurfaceContainerHighest">@color/kazuji_surfaceContainerHighest</item>
		<item name="colorSurfaceVariant">@color/kazuji_surfaceVariant</item>
		<item name="colorOnSurface">@color/kazuji_onSurface</item>
		<item name="colorOnSurfaceVariant">@color/kazuji_onSurfaceVariant</item>
		<item name="colorSurfaceInverse">@color/kazuji_inverseSurface</item>
		<item name="colorOnSurfaceInverse">@color/kazuji_inverseOnSurface</item>
		<item name="colorOnBackground">@color/kazuji_onSurface</item>
		<item name="colorError">@color/error</item>
		<item name="colorErrorContainer">@color/errorContainer</item>

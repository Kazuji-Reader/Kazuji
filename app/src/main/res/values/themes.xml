		<item name="colorOutline">@color/kazuji_outline</item>
		<item name="colorOutlineVariant">@color/kazuji_outline</item>

		<!-- Drawables (icons) -->
		<item name="actionModeCloseDrawable">@drawable/abc_ic_clear_material</item>
		<item name="actionModeWebSearchDrawable">@drawable/abc_ic_search_api_material</item>
		<item name="expandCollapseIndicator">@drawable/m3_split_button_chevron_avd</item>

		<!-- Base attributes -->
		<item name="android:windowLightStatusBar">@bool/light_status_bar</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@color/dim</item>
		<item name="android:navigationBarDividerColor" tools:targetApi="o_mr1">@null</item>
		<item name="android:enforceNavigationBarContrast" tools:targetApi="Q">false</item>
		<item name="android:enforceStatusBarContrast" tools:targetApi="Q">false</item>
		<item name="windowActionModeOverlay">true</item>

		<!-- System components styles -->
		<item name="android:alertDialogTheme">@style/ThemeOverlay.Kazuji.AlertDialog</item>
		<item name="alertDialogTheme">@style/ThemeOverlay.Kazuji.AlertDialog</item>
		<item name="bottomSheetDialogTheme">@style/ThemeOverlay.Kazuji.BottomSheetDialog</item>
		<item name="sideSheetDialogTheme">@style/ThemeOverlay.Kazuji.SideSheetDialog</item>
		<item name="recyclerViewStyle">@style/Widget.Kazuji.RecyclerView</item>
		<item name="android:dropDownSpinnerStyle">@style/Widget.Kazuji.Spinner.DropDown</item>
		<item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.M3</item>
		<item name="circularProgressIndicatorStyle">@style/Widget.Kazuji.CircularProgressIndicator</item>
		<item name="linearProgressIndicatorStyle">@style/Widget.Kazuji.LinearProgressIndicator</item>
		<item name="bottomSheetDragHandleStyle">@style/Widget.Kazuji.BottomSheet.DragHandle</item>
		<item name="preferenceTheme">@style/PreferenceThemeOverlay.Kazuji</item>
		<!-- Fix crash in A15 -->
		<item name="actionButtonStyle">@style/Widget.AppCompat.ActionButton</item>

		<!-- Custom views -->
		<item name="fastScrollerStyle">@style/Widget.Kazuji.FastScroller</item>
		<item name="listItemTextViewStyle">@style/Widget.Kazuji.ListItemTextView</item>
		<item name="dotIndicatorStyle">@style/Widget.Kazuji.DotIndicator</item>
		<item name="badgeViewStyle">@style/Widget.Kazuji.BadgeView</item>
		<item name="coverImageViewStyle">@style/Widget.Kazuji.ImageView.Cover</item>
	</style>

	<!--== Default Theme ==-->
	<style name="Theme.Kazuji" parent="Base.Theme.Kazuji" />

	<!-- Base ThemeOverlay -->
	<style name="ThemeOverlay.Kazuji" parent="ThemeOverlay.Material3.Light" />

	<!-- Monet theme only support S+ -->
	<style name="ThemeOverlay.Kazuji.Monet" parent="ThemeOverlay.Material3.DynamicColors.Light" />


	<style name="ThemeOverlay.Kazuji.Expressive" parent="ThemeOverlay.Material3Expressive.DynamicColors.DayNight">
		<item name="alertDialogTheme">@style/ThemeOverlay.Material3Expressive.Dialog.Alert</item>
